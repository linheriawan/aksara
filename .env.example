# Application
NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:3000
PORT=3000
WS_PORT=3001

# Database
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/platform?retryWrites=true&w=majority
MONGODB_DB=aksaraIS

# SSO/OAuth Configuration - Aksara SSO Integration
SSO_BASE_URL=http://localhost:5173
SSO_AUTHORIZATION_URL=/oauth/authorize
SSO_TOKEN_URL=/oauth/token
SSO_USERINFO_URL=/oauth/userinfo
SSO_JWKS_URL=/.well-known/jwks.json
SSO_DISCOVERY_URL=/.well-known/openid-configuration
SSO_CLIENT_ID=aksaraIS
SSO_CLIENT_SECRET=hr-secret-key
SSO_REDIRECT_URI=http://localhost:3000/
SSO_SCOPES=openid email profile roles

# Authentication
JWT_SECRET=your_secret_key_change_this_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_COOKIE_NAME=session
SESSION_MAX_AGE=86400

# advProto Service
ADVPROTO_WS_URL=ws://localhost:8080
ADVPROTO_GRPC_URL=localhost:9090

# Optional Services
RABBITMQ_URL=amqp://localhost:5672
MQTT_BROKER_URL=mqtt://localhost:1883

# Security
ENCRYPTION_KEY=your_encryption_key_change_this_in_production
API_KEY_SALT=your_api_key_salt_change_this_in_production
CRYPTO_SECRET=your_crypto_secret_for_datasource_credentials_change_in_production

# Feature Flags
ENABLE_MQTT=false
ENABLE_MESSAGE_QUEUE=false
ENABLE_ISO8583=false
ENABLE_FIX=false

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
